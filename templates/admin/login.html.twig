{% extends 'base.html.twig' %}

{% block title %}Admin — Connexion{% endblock %}

{% block stylesheets %}
<style>
    .login {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; min-height: 100vh; padding: 2rem;
    }
    .login h1 { margin-bottom: 2rem; font-size: 1.5rem; color: #888; }
    .login form { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 300px; }
    .login input {
        padding: 0.8rem 1rem; background: #1a1a1a; border: 1px solid #333;
        border-radius: 6px; color: #fff; font-size: 1rem; outline: none;
    }
    .login input:focus { border-color: #7c9fff; }
    .login button {
        padding: 0.8rem; background: #7c9fff; color: #0f0f0f;
        font-weight: 600; border: none; border-radius: 6px; cursor: pointer;
    }
    .error { color: #ff6b6b; font-size: 0.9rem; }
</style>
{% endblock %}

{% block body %}
<div class="login">
    <h1>Admin</h1>
    <form method="POST">
        <input type="password" name="password" placeholder="Mot de passe" autofocus>
        <button type="submit">Connexion</button>
        {% if error is defined %}<p class="error">{{ error }}</p>{% endif %}
    </form>
</div>
{% endblock %}
