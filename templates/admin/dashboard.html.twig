{% extends 'base.html.twig' %}

{% block title %}Admin — Dashboard{% endblock %}

{% block stylesheets %}
<style>
    .admin { max-width: 1000px; margin: 0 auto; padding: 3rem 2rem; }
    .admin header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; }
    .admin h1 { font-size: 1.8rem; }
    .admin a.logout { color: #ff6b6b; font-size: 0.9rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 3rem; }
    .stat-card {
        background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 8px;
        padding: 1.5rem; text-align: center;
    }
    .stat-card .value { font-size: 2.5rem; font-weight: 700; color: #7c9fff; }
    .stat-card .label { color: #888; font-size: 0.85rem; margin-top: 0.3rem; }
    .stat-card .last { color: #555; font-size: 0.75rem; margin-top: 0.5rem; }
    section { margin-bottom: 3rem; }
    section h2 { font-size: 1.1rem; color: #7c9fff; margin-bottom: 1rem; border-bottom: 1px solid #222; padding-bottom: 0.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { padding: 0.6rem 1rem; text-align: left; border-bottom: 1px solid #1e1e1e; }
    th { color: #888; font-weight: 500; }
    tr:hover td { background: #161616; }
    .badge {
        display: inline-block; padding: 0.2rem 0.5rem; border-radius: 4px;
        font-size: 0.75rem; background: #1a1a2e; border: 1px solid #7c9fff; color: #7c9fff;
    }
</style>
{% endblock %}

{% block body %}
<div class="admin">
    <header>
        <h1>Dashboard visiteurs</h1>
        <a class="logout" href="{{ path('admin_logout') }}">Déconnexion</a>
    </header>

    {# Stats par profil #}
    <div class="stats-grid">
        {% for stat in statsByProfile %}
        <div class="stat-card">
            <div class="value">{{ stat.visits }}</div>
            <div class="label">{{ stat.profileType }}</div>
            <div class="last">Dernier : {{ stat.lastVisit|date('d/m/Y H:i') }}</div>
        </div>
        {% else %}
        <p style="color:#555">Aucune visite enregistrée.</p>
        {% endfor %}
    </div>

    {# Stats par code #}
    <section>
        <h2>Par code recruteur</h2>
        <table>
            <thead><tr><th>Code</th><th>Profil</th><th>Visites</th><th>Dernière visite</th></tr></thead>
            <tbody>
            {% for stat in statsByCode %}
                <tr>
                    <td><code>{{ stat.code }}</code></td>
                    <td><span class="badge">{{ stat.profileType }}</span></td>
                    <td>{{ stat.visits }}</td>
                    <td>{{ stat.lastVisit|date('d/m/Y H:i') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" style="color:#555">Aucune donnée.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>

    {# Visites récentes #}
    <section>
        <h2>50 dernières visites</h2>
        <table>
            <thead><tr><th>Date</th><th>Code</th><th>Profil</th><th>Page</th><th>IP</th></tr></thead>
            <tbody>
            {% for visit in recentVisits %}
                <tr>
                    <td>{{ visit.createdAt|date('d/m/Y H:i:s') }}</td>
                    <td><code>{{ visit.code }}</code></td>
                    <td><span class="badge">{{ visit.profileType }}</span></td>
                    <td>{{ visit.page }}</td>
                    <td>{{ visit.ip }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" style="color:#555">Aucune visite.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
